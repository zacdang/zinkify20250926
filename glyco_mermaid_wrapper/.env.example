# Set to "mock" to use sample data without real tools installed.
# Set to "real" when MERMaid and ChemDataExtractor are available.
PIPELINE_MODE=mock

# Paths (relative to project root)
DATA_DIR=data
SAMPLES_DIR=data/samples
MERMAID_OUTPUT_DIR=data/mermaid_outputs
CDE_OUTPUT_DIR=data/cde_outputs
PARSED_DIR=data/parsed
INTERMEDIATE_DIR=data/intermediate
OUTPUT_DIR=data/outputs

# Optional: absolute path to the MERMaid CLI executable
# MERMAID_CLI_PATH=/path/to/mermaid/cli
